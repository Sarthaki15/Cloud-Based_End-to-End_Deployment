# ---- Server ----
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://menu.yourcafe.com

# ---- AWS Cognito (Authentication tier) ----
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Data tier: DynamoDB (recommended, serverless) ----
DYNAMO_MENU_TABLE=CafeMenuItems
DYNAMO_ORDERS_TABLE=CafeOrders

# ---- OR Data tier: RDS (if using relational DB instead) ----
# DB_HOST=cafe-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=cafedb
# DB_USER=cafeadmin
# DB_PASSWORD=changeme

# AWS credentials are normally NOT put in .env in production.
# Use an IAM Role attached to the EC2/ECS/Elastic Beanstalk instance instead.
# For local development only:
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
